PORT=4000

# SQLite database file (auto-created on first run)
DATABASE_PATH=./mindcare.db

# 32-byte random secrets for JWT and journal encryption
JWT_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JOURNAL_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:4000,http://localhost:5173,http://127.0.0.1:4000

# Toll-free national mental health helpline shown on every crisis banner (India)
CRISIS_HELPLINE_NAME=Tele-MANAS
CRISIS_HELPLINE_NUMBER=14416
